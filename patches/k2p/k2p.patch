Index: src/router/libutils/libutils/gpio.c
===================================================================
--- src/router/libutils/libutils/gpio.c	(revision HEAD)
+++ src/router/libutils/libutils/gpio.c	(working copy)
@@ -1238,6 +1238,25 @@ int gpio_write_bit(int gpio, int setvalue)
 
 void set_gpio(int pin, int value)
 {
+	if (pin == 13) {
+		writeint("/sys/class/leds/red:status/brightness", value);
+		writeint("/sys/class/leds/yellow:status/brightness", !value);
+		writeint("/sys/class/leds/blue:status/brightness", 0);
+		return;
+	}
+	if (pin == 14) {
+		writeint("/sys/class/leds/red:status/brightness", !value);
+		writeint("/sys/class/leds/yellow:status/brightness", value);
+		writeint("/sys/class/leds/blue:status/brightness", 0);
+		return;
+	}
+	if (pin == 15) {
+		writeint("/sys/class/leds/red:status/brightness", 0);
+		writeint("/sys/class/leds/yellow:status/brightness", !value);
+		writeint("/sys/class/leds/blue:status/brightness", value);
+		return;
+	}
+
 	if (pin > 95) {
 		set_linux_gpio(pin, value);
 	} else {
@@ -1248,6 +1267,9 @@ void set_gpio(int pin, int value)
 
 int get_gpio(int pin)
 {
+	if (pin >= 13 && pin <= 15)
+		return 0;
+
 	int value;
 	if (pin > 95)
 		get_linux_gpio(pin);
